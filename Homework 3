    "def alternating_sign_mean(values):\n",
    "    sum = 0.0\n",
    "    count = len(values)\n",
    "    for i in np.arange(0,len(values),1):\n",
    "        if i % 2 == 0:\n",
    "            sum += values[i]\n",
    "        elif i % 2 == 1:\n",
    "            sum -= values[i]\n",
    "    return sum / count\n",
    "    \n",
    "# Feel free to change this input to make sure your function works correctly.\n",
    "alternating_sign_mean(np.array([3, 2, 9.5]))"
